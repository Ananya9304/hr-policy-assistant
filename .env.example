# Copy to .env and fill in. Never commit .env.

# --- LLM: any OpenAI-compatible endpoint. Pick ONE block. ---
# Groq (default; free key at https://console.groq.com/keys)
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=your-groq-key
LLM_MODEL=openai/gpt-oss-120b

# Google Gemini (free key at https://aistudio.google.com/apikey)
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_API_KEY=your-gemini-key
# LLM_MODEL=gemini-2.5-flash

# Ollama, fully local (run: ollama pull llama3.1:8b)
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=llama3.1:8b

# --- Embeddings (local, free) ---
EMBEDDING_BACKEND=sentence-transformers
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Retrieval tuning ---
TOP_K=5
MIN_DENSE_SCORE=0.20

# --- App ---
DB_PATH=data/index.db
ADMIN_TOKEN=change-me
HR_CONTACT=HR at hr@example.com
API_URL=http://localhost:8000
